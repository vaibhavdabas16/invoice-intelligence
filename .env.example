# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your-openai-api-key-here

# --- Optional overrides (defaults shown) ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-6-luna
# LLM_EFFORT=low               # reasoning effort: none | low | medium | high
# IMAGE_DETAIL=high
# LLM_MAX_OUTPUT_TOKENS=16000
# LLM_TIMEOUT_S=90
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_DELAY_S=2
# LLM_MAX_REPAIR_ATTEMPTS=1
# VERIFY_SCANS=true          # second independent read for scans/photos; disagreement -> needs_review
# UPSCALE_IMAGES=true        # upscale small photos to MAX_IMAGE_EDGE_PX like PDF pages (measured: fewer misreads)
# INPUT_MODE=hybrid            # hybrid | image | text
# MAX_IMAGE_EDGE_PX=1568
# MAX_PAGES=10
# MAX_FILE_MB=20
# AMOUNT_TOLERANCE=0.02
# LLM_USE_CACHE=true
# LLM_CACHE_DIR=.cache/llm
# DATA_DIR=data
# OUTPUTS_DIR=outputs
# REPORTS_DIR=reports
